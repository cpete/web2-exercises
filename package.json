{
  "name": "web2-exercises",
  "version": "0.1.0",
  "description": "Web 2 course exercises",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "concurrently -n backend,web -c blue,green \"npm:start:backend\" \"npm:start:web\"",
    "start:backend": "node dist/index.js",
    "start:web": "http-server public -p ${WEB_PORT:-8080}",
    "dev": "concurrently -n backend,web -c blue,green \"npm:dev:backend\" \"npm:dev:web\"",
    "dev:backend": "tsx watch src/index.ts",
    "dev:web": "http-server public -p ${WEB_PORT:-8080}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "Chris Peters",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "http-server": "^14.1.1"
  }
}
